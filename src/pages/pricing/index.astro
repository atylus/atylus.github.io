---
import PageDocument from '../../components/app/PageDocument.astro';
import { PricingPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("pricing");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/pricing/"
>
  <PricingPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>