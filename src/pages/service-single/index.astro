---
import LegacyPage from "../../components/legacy/LegacyPage.astro";
import { getServiceBySlug } from "@/data/serviceCatalog";

const fallbackService = getServiceBySlug("risk-ve-anomali-analizi");

if (!fallbackService) {
  throw new Error("Fallback service catalog item is missing.");
}
---

<LegacyPage
  title={fallbackService.seoTitle}
  description={fallbackService.seoDescription}
  canonicalPath="/service-single/"
  sharedLayout="marketing"
  routeId="service-single"
/>
