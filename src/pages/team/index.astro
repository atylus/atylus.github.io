---
import PageDocument from '../../components/app/PageDocument.astro';
import { TeamPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("team");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/team/"
>
  <TeamPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>