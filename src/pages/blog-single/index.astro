---
import PageDocument from '../../components/app/PageDocument.astro';
import { BlogSinglePageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("blog-single");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/blog-single/"
>
  <BlogSinglePageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>