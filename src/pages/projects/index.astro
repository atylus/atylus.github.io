---
import PageDocument from "../../components/app/PageDocument.astro";
import ProjectsListingPage from "../../components/projects/ProjectsListingPage.astro";
import { getPageSeo } from "@/i18n/content";
import { getMarketingPageAlternates, getLocalizedPagePath } from "@/i18n/routes";
import { getVendilusProjectPath } from "@/data/vendilus";

const locale = "tr";
const metadata = getPageSeo(locale, "projects");
const canonicalPath = getLocalizedPagePath(locale, "projects");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Atylus Projeler",
  url: new URL(canonicalPath, "https://atylus.com").toString(),
  inLanguage: "tr-TR",
  hasPart: [
    {
      "@type": "SoftwareApplication",
      name: "Vendilus",
      url: new URL(getVendilusProjectPath(locale), "https://atylus.com").toString(),
    },
  ],
};
---
<PageDocument
  title={metadata.title}
  description={metadata.description}
  canonicalPath={canonicalPath}
  locale={locale}
  alternates={getMarketingPageAlternates("projects")}
  showStaticChrome={true}
  structuredData={structuredData}
>
  <ProjectsListingPage locale={locale} />
</PageDocument>
