---
import PageDocument from '../../components/app/PageDocument.astro';
import { GalleryMasonryPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("gallery-masonry");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/gallery-masonry/"
>
  <GalleryMasonryPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>