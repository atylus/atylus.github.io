---
import PageDocument from '../../components/app/PageDocument.astro';
import { ProjectSinglePageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("project-single");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/project-single/"
>
  <ProjectSinglePageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>