---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getSiteMetadata } from "../../../data/site";
import { SUPPORTED_LOCALES, type SupportedLocale } from "@/i18n/config";
import { getUiCopy } from "@/i18n/content";
import { getLocalizedBlogPostPath } from "@/data/blogCatalog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts
    .filter((post: CollectionEntry<"blog">) => !post.data.draft)
    .map((post: CollectionEntry<"blog">) => ({
      params: {
        locale: post.data.locale,
        slug: post.data.slug,
      },
      props: { post },
    }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const locale = post.data.locale as SupportedLocale;
const ui = getUiCopy(locale);
const siteMetadata = getSiteMetadata(locale);
const { Content } = await render(post);
const heroImage = post.data.heroImage ?? siteMetadata.defaultOgImage;
const alternates = Object.fromEntries(
  SUPPORTED_LOCALES.map((item) => [
    item,
    getLocalizedBlogPostPath(item, post.data.translationKey),
  ]),
);
---

<Layout
  title={`${post.data.title} | ${siteMetadata.title}`}
  description={post.data.description}
  image={heroImage}
  canonicalPath={getLocalizedBlogPostPath(locale, post.data.translationKey)}
  locale={locale}
  alternates={alternates}
  ogType="article"
  showStaticChrome={true}
>
  <section class="page-banner5">
    <div class="shape" />
    <div class="shape3" />
    <div class="staff-text">{ui.breadcrumbs.blog}</div>
    <div class="container">
      <div class="page-content">
        <h1 class="title">/ {post.data.title} /</h1>
      </div>
    </div>
    <ul class="breadcrumbs">
      <li>
        <a href={`/${locale}/`}>{ui.breadcrumbs.home}</a>
      </li>
      <li>/</li>
      <li>
        <a href={`/${locale}/blog/`}>{ui.breadcrumbs.blog}</a>
      </li>
      <li>/</li>
      <li>{post.data.title}</li>
    </ul>
  </section>

  <section class="blog-sec ibt-section-gap">
    <div class="container">
      <article class="blog-card">
        <div class="blog-content">
          <span class="sub-title">
            {post.data.pubDate.toLocaleDateString(locale === "tr" ? "tr-TR" : locale === "de" ? "de-DE" : "en-US")} · {post.data.author}
          </span>
          <h2 class="title">{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="blog-post-body">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>

<style>
  .blog-post-body :global(h2) {
    margin-top: 2rem;
  }

  .blog-post-body :global(pre) {
    overflow-x: auto;
  }
</style>
