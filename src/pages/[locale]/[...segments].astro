---
import PageDocument from "../../components/app/PageDocument.astro";
import ProjectsListingPage from "@/components/projects/ProjectsListingPage.astro";
import VendilusProjectPage from "@/components/projects/VendilusProjectPage.astro";
import {
  ContactPageIsland,
  FaqPageIsland,
  FeatureBilgisayarliGoruCozumleriPageIsland,
  FeatureOngoruselVeriAnalitigiPageIsland,
  FeatureOzelYazilimCozumleriPageIsland,
  FeatureYapaySinirAgiGelistirmePageIsland,
  FeatureYapayZekaDanismanligiPageIsland,
  FeatureYapayZekaSistemEntegrasyonuPageIsland,
  FeatureYapayZekaTeknolojileriPageIsland,
  FeatureYazilimGelistirmeSurecleriPageIsland,
  GalleryGridPageIsland,
  GalleryMasonryPageIsland,
  HakkimizdaPageIsland,
  HizmetlerPageIsland,
  PricingPageIsland,
  ServiceDetailPageIsland,
  TeamPageIsland,
  TeamSinglePageIsland,
} from "@/components/app/PageIslands";
import {
  SUPPORTED_LOCALES,
  type SupportedLocale,
} from "@/i18n/config";
import { getPageSeo } from "@/i18n/content";
import {
  SERVICE_SECTION_SEGMENTS,
  getAllMarketingPagesForLocale,
  getMarketingPageAlternates,
  getLocalizedPagePath,
  joinLocalizedPath,
} from "@/i18n/routes";
import {
  getServiceCatalogItems,
  getServiceHref,
  getServiceByKey,
} from "@/data/serviceCatalog";
import type { ServiceCatalogItem } from "@/types/services";

type PageProps =
  | {
      locale: SupportedLocale;
      type: "marketing";
      pageKey: import("@/i18n/routes").MarketingPageKey;
    }
  | {
      locale: SupportedLocale;
      type: "service";
      service: ServiceCatalogItem;
    };

export function getStaticPaths() {
  const paths = [];

  for (const locale of SUPPORTED_LOCALES) {
    for (const page of getAllMarketingPagesForLocale(locale)) {
      if (page.key === "home") {
        continue;
      }

      paths.push({
        params: {
          locale,
          segments: page.path.split("/").filter(Boolean).slice(1).join("/"),
        },
        props: {
          locale,
          type: "marketing",
          pageKey: page.key,
        } satisfies PageProps,
      });
    }

    for (const service of getServiceCatalogItems(locale)) {
      paths.push({
        params: {
          locale,
          segments: [SERVICE_SECTION_SEGMENTS[locale], service.slug].join("/"),
        },
        props: {
          locale,
          type: "service",
          service,
        } satisfies PageProps,
      });
    }
  }

  return paths;
}

const props = Astro.props as PageProps;
---

{
  props.type === "marketing" ? (
    (() => {
      const metadata = getPageSeo(props.locale, props.pageKey);

      let structuredData = undefined;
      if (props.pageKey === "contact") {
        structuredData = {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "Atylus Kurumsal Yapay Zeka ve Otomasyon Cozumleri",
          "image": "https://atylus.com/assets/images/logo-dark.svg",
          "@id": "https://atylus.com",
          "url": "https://atylus.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Merkez Ofis",
            "addressLocality": "Kayseri",
            "addressRegion": "Ic Anadolu",
            "addressCountry": "TR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 38.7205,
            "longitude": 35.4826
          },
          "areaServed": ["Kayseri", "Ic Anadolu", "Turkiye"],
          "description": metadata.description,
          "sameAs": [
             "https://www.linkedin.com/atylus_offical/",
             "https://www.twitter.com/atylus_offical/",
             "https://www.facebook.com/atylus_offical/",
             "https://www.youtube.com/atylus_offical/"
          ]
        };
      }

      return (
        <PageDocument
          title={metadata.title}
          description={metadata.description}
          canonicalPath={getLocalizedPagePath(props.locale, props.pageKey)}
          locale={props.locale}
          alternates={getMarketingPageAlternates(props.pageKey)}
          showStaticChrome={props.pageKey === "projects" || props.pageKey === "vendilusProject"}
          structuredData={structuredData}
        >
          {
            props.pageKey === "projects" ? (
              <ProjectsListingPage locale={props.locale} />
            ) : props.pageKey === "vendilusProject" ? (
              <VendilusProjectPage locale={props.locale} />
            ) : props.pageKey === "about" ? (
              <HakkimizdaPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "contact" ? (
              <ContactPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "services" ? (
              <HizmetlerPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "faq" ? (
              <FaqPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "pricing" ? (
              <PricingPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "team" ? (
              <TeamPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "teamMember" ? (
              <TeamSinglePageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "galleryGrid" ? (
              <GalleryGridPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "galleryMasonry" ? (
              <GalleryMasonryPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "computerVisionSolutions" ? (
              <FeatureBilgisayarliGoruCozumleriPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "predictiveAnalytics" ? (
              <FeatureOngoruselVeriAnalitigiPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "customSoftwareSolutions" ? (
              <FeatureOzelYazilimCozumleriPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "neuralNetworkDevelopment" ? (
              <FeatureYapaySinirAgiGelistirmePageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "aiConsulting" ? (
              <FeatureYapayZekaDanismanligiPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "aiSystemIntegration" ? (
              <FeatureYapayZekaSistemEntegrasyonuPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "aiTechnologies" ? (
              <FeatureYapayZekaTeknolojileriPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : props.pageKey === "softwareDevelopmentProcesses" ? (
              <FeatureYazilimGelistirmeSurecleriPageIsland client:load pathname={Astro.url.pathname} locale={props.locale} />
            ) : (
              null
            )
          }
        </PageDocument>
      );
    })()
  ) : (
    (() => {
      const serviceAlternates = Object.fromEntries(
        SUPPORTED_LOCALES.map((locale) => {
          const localizedService = getServiceByKey(locale, props.service.key);
          return [locale, localizedService ? getServiceHref(locale, localizedService.key) : joinLocalizedPath(locale, SERVICE_SECTION_SEGMENTS[locale])];
        }),
      );

      return (
        <PageDocument
          title={props.service.seoTitle}
          description={props.service.seoDescription}
          canonicalPath={getServiceHref(props.locale, props.service.key)}
          locale={props.locale}
          alternates={serviceAlternates}
        >
          <ServiceDetailPageIsland
            client:load
            pathname={Astro.url.pathname}
            locale={props.locale}
            service={props.service}
          />
        </PageDocument>
      );
    })()
  )
}
