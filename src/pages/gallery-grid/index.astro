---
import PageDocument from '../../components/app/PageDocument.astro';
import { GalleryGridPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("gallery-grid");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/gallery-grid/"
>
  <GalleryGridPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>