---
import PageDocument from '../../components/app/PageDocument.astro';
import { TeamSinglePageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("team-single");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/team-single/"
>
  <TeamSinglePageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>