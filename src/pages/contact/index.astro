---
import PageDocument from '../../components/app/PageDocument.astro';
import { ContactPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("contact");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/contact/"
  showContactSection={false}
>
  <ContactPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>
