---
import PageDocument from '../components/app/PageDocument.astro';
import { HomePageIsland } from '../components/app/PageIslands';
import { getDemoMetadata } from '@/data/demo';
const metadata = getDemoMetadata(3);
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/"
>
  <HomePageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>