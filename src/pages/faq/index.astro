---
import PageDocument from '../../components/app/PageDocument.astro';
import { FaqPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("faq");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/faq/"
>
  <FaqPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>