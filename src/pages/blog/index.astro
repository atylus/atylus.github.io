---
import PageDocument from '../../components/app/PageDocument.astro';
import { BlogPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("blog2");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/blog/"
>
  <BlogPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>