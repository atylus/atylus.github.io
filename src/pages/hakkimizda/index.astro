---
import PageDocument from '../../components/app/PageDocument.astro';
import { HakkimizdaPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("hakkimizda");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/hakkimizda/"
>
  <HakkimizdaPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>