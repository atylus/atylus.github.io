---
import LegacyPage from "../../components/legacy/LegacyPage.astro";
import { serviceCatalogItems } from "@/data/serviceCatalog";

export function getStaticPaths() {
  return serviceCatalogItems.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<LegacyPage
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={`/hizmetler/${service.slug}/`}
  sharedLayout="marketing"
  routeId="service-detail"
  service={service}
/>
