---
import PageDocument from "../../components/app/PageDocument.astro";
import { ServiceDetailPageIsland } from "../../components/app/PageIslands";
import { serviceCatalogItems } from "@/data/serviceCatalog";

export function getStaticPaths() {
  return serviceCatalogItems.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<PageDocument
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={`/hizmetler/${service.slug}/`}
>
  <ServiceDetailPageIsland
    client:load
    pathname={Astro.url.pathname}
    service={service}
  />
</PageDocument>
