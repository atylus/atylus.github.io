---
import PageDocument from '../../components/app/PageDocument.astro';
import { HizmetlerPageIsland } from '../../components/app/PageIslands';
import { getPageMetadata } from '@/data/pages';
const metadata = getPageMetadata("service");
---
<PageDocument
  title={String(metadata.title)}
  description={String(metadata.description)}
  canonicalPath="/hizmetler/"
>
  <HizmetlerPageIsland client:load pathname={Astro.url.pathname} />
</PageDocument>