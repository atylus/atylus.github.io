---
import Layout from "../../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  locale?: "tr" | "en" | "de";
  alternates?: Record<string, string>;
  image?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  showStaticChrome?: boolean;
  showContactSection?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  locale = "tr",
  alternates,
  image,
  ogType = "website",
  noindex = false,
  showStaticChrome = false,
  showContactSection = true,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
  alternates={alternates}
  image={image}
  ogType={ogType}
  noindex={noindex}
  showStaticChrome={showStaticChrome}
  showContactSection={showContactSection}
>
  <slot />
</Layout>
