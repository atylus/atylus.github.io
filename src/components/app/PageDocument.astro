---
import Layout from "../../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image,
  ogType = "website",
  noindex = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  ogType={ogType}
  noindex={noindex}
>
  <slot />
</Layout>
