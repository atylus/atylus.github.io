---
import type { SupportedLocale } from "@/i18n/config";
import { getUiCopy } from "@/i18n/content";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = getUiCopy(locale);
---

<div class="contact-sec ibt-section-gap" id="contact">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="contact-content">
          <div class="sec-title white">
            <span class="sub-title">{ui.contact.eyebrow}</span>
            <h2 class="title animated-heading">{ui.contact.title}</h2>
            <p>{ui.contact.description}</p>
          </div>
          <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6">
                <div class="contact-info">
                  <div class="call-center">
                  <h4 class="title">{ui.contact.phone}</h4>
                  <span class="nmbr">&nbsp;</span>
                  <span class="nmbr">&nbsp;</span>
                </div>
                <div class="call-center mb-0">
                  <h4 class="title">{ui.contact.email}</h4>
                  <a href="mailto:info@atylus.com" class="gmail">info@atylus.com</a>
                </div>
              </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6">
              <div class="contact-info">
                <div class="call-center">
                  <h4 class="title">{ui.contact.location}</h4>
                  <p>
                    {ui.contact.locationLines[0]} <br />
                    {ui.contact.locationLines[1]}
                  </p>
                </div>
                <div class="call-center mb-0">
                  <h4 class="title">{ui.contact.social}</h4>
                  <ul class="social-icon">
                    <li>
                      <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-facebook-f" />
                      </a>
                    </li>
                    <li>
                      <a href="https://www.twitter.com/" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-twitter" />
                      </a>
                    </li>
                    <li>
                      <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-linkedin-in" />
                      </a>
                    </li>
                    <li>
                      <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-youtube" />
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="contact-form">
          <form class="contact-form-style">
            <div class="row">
              <div class="col-md-6">
                <input type="text" name="name" placeholder={ui.contact.formName} />
              </div>
              <div class="col-md-6">
                <input type="email" name="email" placeholder={ui.contact.formEmail} />
              </div>
              <div class="col-12">
                <textarea name="message" rows="5" placeholder={ui.contact.formMessage} />
              </div>
              <div class="col-12">
                <button type="submit" class="ibt-btn ibt-btn-outline">
                  <span>{ui.contact.formSubmit}</span>
                  <i class="icon-arrow-top" />
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
